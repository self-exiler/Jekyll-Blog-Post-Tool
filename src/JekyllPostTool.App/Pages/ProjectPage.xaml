<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JekyllPostTool_App.Pages.ProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="项目" />

        <StackPanel Grid.Row="1" Spacing="12">
            <ct:SettingsCard
                Header="项目路径"
                Description="{x:Bind ViewModel.ProjectPath, Mode=OneWay}"
                HorizontalContentAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.SelectProjectPathCommand}"
                        Content="选择项目路径"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Command="{x:Bind ViewModel.OpenInExplorerCommand}"
                        Content="资源管理器" />
                    <Button
                        Command="{x:Bind ViewModel.OpenInVsCodeCommand}"
                        Content="VS Code" />
                </StackPanel>
            </ct:SettingsCard>
        </StackPanel>
    </Grid>
</Page>
