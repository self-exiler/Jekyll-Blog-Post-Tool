<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JekyllPostTool_App.Pages.PostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:JekyllPostTool_App.ViewModels"
    Loaded="OnLoaded"
    SizeChanged="OnSizeChanged"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <!--
                布局状态由 PostPage.xaml.cs 的 OnSizeChanged 按逻辑像素驱动。
                不使用 AdaptiveTrigger：WinUI 3 桌面版中其 MinWindowWidth
                以物理像素度量，不同 DPI 缩放下行为不一致。
            -->
            <VisualStateGroup x:Name="LayoutStates">
                <!-- 宽窗口：表单与预览左右分栏（3:2） -->
                <VisualState x:Name="WideLayout" />
                <!-- 窄窗口：表单在上，预览在下，整页滚动 -->
                <VisualState x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="PreviewColumn.Width" Value="0" />
                        <Setter Target="ContentGrid.ColumnSpacing" Value="0" />
                        <Setter Target="PreviewPanel.(Grid.Row)" Value="1" />
                        <Setter Target="PreviewPanel.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.NewPostCommand}"
                    Content="新建博文" />
                <Button
                    Command="{x:Bind ViewModel.OpenPostCommand}"
                    Content="打开已有博文" />
                <Button
                    Command="{x:Bind ViewModel.SavePostCommand}"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <Grid
                x:Name="ContentGrid"
                ColumnSpacing="24"
                RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="16">
                    <ct:SettingsCard
                        ContentAlignment="Vertical"
                        Header="基本信息"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBox
                                Header="title *"
                                Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto">
                                <CalendarDatePicker
                                    MinWidth="168"
                                    Date="{x:Bind ViewModel.SelectedDate, Mode=TwoWay}"
                                    PlaceholderText="选择日期" />
                                <TimePicker
                                    Grid.Column="1"
                                    MinWidth="108"
                                    Time="{x:Bind ViewModel.SelectedTime, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="2"
                                    MinWidth="84"
                                    ItemsSource="{x:Bind ViewModel.TimeZoneOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedTimeZone, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </ct:SettingsCard>

                    <ct:SettingsCard
                        ContentAlignment="Vertical"
                        Header="分类"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBox
                                Header="主分类"
                                Text="{x:Bind ViewModel.Category1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Header="子分类"
                                IsEnabled="{x:Bind ViewModel.HasCategory1, Mode=OneWay}"
                                Text="{x:Bind ViewModel.Category2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ct:SettingsCard>

                    <ct:SettingsCard
                        ContentAlignment="Vertical"
                        Header="标签"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBox
                                PlaceholderText="用逗号分隔多个标签"
                                Text="{x:Bind ViewModel.Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Command="{x:Bind ViewModel.ExtractKeywordsCommand}"
                                Content="AI 提取关键字" />
                        </StackPanel>
                    </ct:SettingsCard>

                    <ct:SettingsCard
                        ContentAlignment="Vertical"
                        Header="作者"
                        HorizontalContentAlignment="Stretch">
                        <DropDownButton Content="{x:Bind ViewModel.SelectedAuthorsDisplay, Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <ListView
                                        MinWidth="240"
                                        ItemsSource="{x:Bind ViewModel.AvailableAuthors}"
                                        SelectionMode="None"
                                        IsItemClickEnabled="False">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AuthorOption">
                                                <CheckBox
                                                    Content="{x:Bind DisplayName}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </ct:SettingsCard>

                    <ct:SettingsCard
                        ContentAlignment="Vertical"
                        Header="描述"
                        HorizontalContentAlignment="Stretch">
                        <TextBox
                            MinHeight="100"
                            AcceptsReturn="True"
                            Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                    </ct:SettingsCard>
                </StackPanel>

                <StackPanel
                    x:Name="PreviewPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="16">
                    <ct:SettingsCard
                        ContentAlignment="Vertical"
                        Header="文件名预览"
                        HorizontalContentAlignment="Stretch">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            Text="{x:Bind ViewModel.FileNamePreview, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ct:SettingsCard>

                    <ct:SettingsCard
                        ContentAlignment="Vertical"
                        Header="front matter 预览"
                        HorizontalContentAlignment="Stretch">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.FrontMatterPreview, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ct:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
