<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JekyllPostTool_App.Pages.AuthorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:JekyllPostTool.Domain.Authors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="作者" />

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.AddAuthorCommand}"
                Content="新增作者"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnSpacing="24"
            ColumnDefinitions="280,*">
            <ListView
                ItemsSource="{x:Bind ViewModel.Authors}"
                SelectedItem="{x:Bind ViewModel.SelectedAuthor, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:Author">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Id}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ct:SettingsCard
                Grid.Column="1"
                ContentAlignment="Vertical"
                Header="作者信息"
                HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <TextBox
                        Header="id *"
                        IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Header="name *"
                        Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Header="twitter"
                        Text="{x:Bind ViewModel.Twitter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Header="url"
                        Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.SaveAuthorCommand}"
                            Content="保存"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.CancelCommand}"
                            Content="取消" />
                        <Button
                            Command="{x:Bind ViewModel.DeleteAuthorCommand}"
                            Content="删除"
                            IsEnabled="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </ct:SettingsCard>
        </Grid>
    </Grid>
</Page>
