<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JekyllPostTool_App.Pages.PostBodyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Markdown 工具栏紧凑按钮 -->
        <Style
            x:Key="FormatButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FormatGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="博文正文" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.NewPostCommand}"
                    Content="新建博文" />
                <Button
                    Command="{x:Bind ViewModel.OpenPostCommand}"
                    Content="打开已有博文" />
                <Button
                    Command="{x:Bind ViewModel.SavePostCommand}"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- 导入正文 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button
                Command="{x:Bind ViewModel.ImportBodyCommand}"
                Content="导入正文..." />
            <CheckBox
                VerticalAlignment="Center"
                Content="替换而非追加"
                IsChecked="{x:Bind ViewModel.ReplaceBodyOnImport, Mode=TwoWay}" />
        </StackPanel>

        <!-- 插入图片（平铺，不折叠） -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="alt 文本" />
            <TextBox
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                PlaceholderText="留空则生成 ![](...)；图片将插入到正文光标处"
                Text="{x:Bind ViewModel.AltText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Name="InsertImagesButton"
                Grid.Column="2"
                Click="OnInsertImagesClick"
                IsEnabled="{x:Bind ViewModel.CanInsertImages, Mode=OneWay}"
                Content="插入图片..."
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- Markdown 工具栏 + 预览开关 -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer
                Padding="0,0,4,0"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Click="OnBoldClick"
                        AutomationProperties.Name="粗体"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="粗体 **文本**">
                        <TextBlock Style="{StaticResource FormatGlyphStyle}" Text="B" />
                    </Button>
                    <Button
                        Click="OnItalicClick"
                        AutomationProperties.Name="斜体"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="斜体 *文本*">
                        <TextBlock FontStyle="Italic" Style="{StaticResource FormatGlyphStyle}" Text="I" />
                    </Button>
                    <Button
                        Click="OnStrikethroughClick"
                        AutomationProperties.Name="删除线"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="删除线 ~~文本~~">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Style="{StaticResource FormatGlyphStyle}"
                            Text="~~" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDividerStyle}" />
                    <Button
                        Click="OnHeading2Click"
                        AutomationProperties.Name="二级标题"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="二级标题 ##">
                        <TextBlock Style="{StaticResource FormatGlyphStyle}" Text="H2" />
                    </Button>
                    <Button
                        Click="OnHeading3Click"
                        AutomationProperties.Name="三级标题"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="三级标题 ###">
                        <TextBlock Style="{StaticResource FormatGlyphStyle}" Text="H3" />
                    </Button>
                    <Button
                        Click="OnQuoteClick"
                        AutomationProperties.Name="引用"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="引用 &gt;">
                        <TextBlock
                            FontSize="16"
                            Style="{StaticResource FormatGlyphStyle}"
                            Text="&#x201C;" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDividerStyle}" />
                    <Button
                        Click="OnInlineCodeClick"
                        AutomationProperties.Name="行内代码"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="行内代码 `文本`">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Style="{StaticResource FormatGlyphStyle}"
                            Text="&lt;/&gt;" />
                    </Button>
                    <Button
                        Click="OnCodeBlockClick"
                        AutomationProperties.Name="代码块"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="代码块 ```">
                        <FontIcon FontSize="14" Glyph="&#xE943;" />
                    </Button>
                    <Button
                        Click="OnLinkClick"
                        AutomationProperties.Name="链接"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="链接 [文本](url)">
                        <FontIcon FontSize="14" Glyph="&#xE71B;" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDividerStyle}" />
                    <Button
                        Click="OnBulletListClick"
                        AutomationProperties.Name="无序列表"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="无序列表 -">
                        <TextBlock FontSize="16" Style="{StaticResource FormatGlyphStyle}" Text="&#x2261;" />
                    </Button>
                    <Button
                        Click="OnOrderedListClick"
                        AutomationProperties.Name="有序列表"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="有序列表 1.">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Style="{StaticResource FormatGlyphStyle}"
                            Text="1." />
                    </Button>
                    <Button
                        Click="OnTableClick"
                        AutomationProperties.Name="插入表格"
                        Style="{StaticResource FormatButtonStyle}"
                        ToolTipService.ToolTip="插入表格模板">
                        <TextBlock FontSize="12" Style="{StaticResource FormatGlyphStyle}" Text="表格" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <ToggleButton
                x:Name="PreviewToggle"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OnPreviewToggleClick"
                        AutomationProperties.Name="切换实时预览"
                IsChecked="True"
                ToolTipService.ToolTip="切换 Markdown 实时预览">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE7B3;" />
                    <TextBlock Text="预览" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- 编辑 + 实时预览 -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="BodyTextBox"
                AcceptsReturn="True"
                FontFamily="Cascadia Mono, Consolas"
                IsTabStop="True"
                MinHeight="240"
                PlaceholderText="在此编辑博文正文，或使用上方工具导入/插入内容..."
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap" />
            <Border
                x:Name="PreviewBorder"
                Grid.Column="1"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <ScrollViewer
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <ct:MarkdownTextBlock
                        x:Name="MarkdownPreview"
                        IsTextSelectionEnabled="True"
                        UseAutoLinks="True"
                        UseEmphasisExtras="True"
                        UsePipeTables="True"
                        UseTaskLists="True" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
