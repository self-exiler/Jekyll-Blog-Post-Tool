<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JekyllPostTool_App.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="高级功能" />

        <ScrollViewer Grid.Row="1" Padding="0,12,0,0">
            <StackPanel Spacing="12">
                <ct:SettingsExpander
                    Header="AI 设置"
                    Description="配置 OpenAI 兼容 API，用于在博文页 AI 提取关键字。"
                    HorizontalContentAlignment="Stretch">
                    <ct:SettingsExpander.Items>
                        <ct:SettingsCard Header="Base URL" Description="如 https://api.openai.com/v1" HorizontalContentAlignment="Stretch">
                            <TextBox
                                PlaceholderText="https://api.openai.com/v1"
                                Text="{x:Bind ViewModel.AiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MinWidth="320" />
                        </ct:SettingsCard>
                        <ct:SettingsCard Header="API Key" Description="以 Bearer 令牌发送" HorizontalContentAlignment="Stretch">
                            <PasswordBox
                                Password="{x:Bind ViewModel.AiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MinWidth="320" />
                        </ct:SettingsCard>
                        <ct:SettingsCard Header="模型" Description="如 gpt-4o-mini" HorizontalContentAlignment="Stretch">
                            <TextBox
                                PlaceholderText="gpt-4o-mini"
                                Text="{x:Bind ViewModel.AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MinWidth="320" />
                        </ct:SettingsCard>
                        <ct:SettingsCard Header="操作" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.SaveAiSettingsCommand}"
                                    Content="保存"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Command="{x:Bind ViewModel.ClearAiSettingsCommand}"
                                    Content="清空" />
                            </StackPanel>
                        </ct:SettingsCard>
                    </ct:SettingsExpander.Items>
                </ct:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
